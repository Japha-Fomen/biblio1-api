            },
            "description": "Un seul exemplaire, pour que le test « deuxième emprunt » soit significatif. Si tu obtiens 500 (UnexpectedTypeException), retire le @Size sur le champ genre de LivreCreationRequest : @Size ne s'applique pas à une énumération.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9782070409228\",\n  \"titre\": \"Les Misérables\",\n  \"anneePublication\": 1862,\n  \"genre\": \"ROMAN\",\n  \"nombreExemplaires\": 1,\n  \"auteurId\": {{auteurId}}\n}",
              "options": {
                "raw": {
                  "language": "json"

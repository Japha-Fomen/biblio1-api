  "item": [
    {
      "name": "1. Auteurs",
      "item": [
        {
          "name": "Créer un auteur",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auteur",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auteur"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codeAuteur\": \"AUT-0001\",\n  \"nom\": \"Hugo\",\n  \"prenom\": \"Victor\",\n  \"nationalite\": \"Française\",\n  \"dateNaissance\": \"1802-02-26\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Statut 201', () => pm.response.to.have.status(201));",
                  "const loc = pm.response.headers.get('Location');",
                  "pm.test('En-tête Location présent', () => pm.expect(loc).to.be.a('string'));",
                  "if (loc) { pm.collectionVariables.set('auteurId', loc.split('/').pop()); }",
                  "pm.test('Le nom est renvoyé', () => pm.expect(pm.response.json().nom).to.eql('Hugo'));"
                ]
              }
            }
          ]
        },
